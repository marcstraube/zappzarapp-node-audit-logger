#!/bin/sh

echo "Running pre-push quality checks..."

# The system Node may be newer than the toolchain supports (e.g. Arch ships
# the latest release). Switch to the version pinned in .nvmrc via nvm so the
# quality checks run on a supported Node instead of failing on a mismatch.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
	# shellcheck disable=SC1091
	. "$NVM_DIR/nvm.sh"
	nvm use >/dev/null 2>&1 || echo "nvm: could not switch to the version in .nvmrc, using $(node -v)"
fi

pnpm run quality

echo "Pre-push checks passed!"
